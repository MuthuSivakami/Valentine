<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5, user-scalable=yes">
    <title>Surprise! · Valentine Love Letters · Heart Bottle</title>
    <!-- Bootstrap 5 soft theme -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Romantic Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        /* -------------------------------
           SURPRISE DESIGN: MESSAGE IN A HEART BOTTLE
           Floating letters, hidden love notes, interactive.
           ALL BLACK HEADS -> RED HEARTS (any black-ish heart removed)
           LAST TWO IMAGES REMOVED
           ---------------------------------------------- */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            background: linear-gradient(125deg, #ffe0f0 0%, #ffc1cc 100%);
            font-family: 'Quicksand', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            padding: 15px;
        }
        
        /* animated wave background (ocean love) - all hearts are red/pink, no black */
        .ocean-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
            opacity: 0.2;
        }
        .ocean-bg i {
            position: absolute;
            color: #ffa5b9; /* soft red/pink */
            font-size: 50px;
            transform: rotate(15deg);
            animation: sway 8s infinite alternate ease-in-out;
        }
        @keyframes sway {
            0% { transform: translateY(0px) rotate(15deg) scale(1); }
            100% { transform: translateY(40px) rotate(5deg) scale(1.1); }
        }

        /* main bottle card */
        .surprise-bottle {
            background: rgba(255, 250, 240, 0.75);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 70px 30px 70px 30px;
            border: 4px solid rgba(255, 220, 240, 0.9);
            box-shadow: 0 40px 60px rgba(200, 50, 80, 0.3);
            max-width: 850px;
            width: 100%;
            padding: 2rem 1.8rem;
            position: relative;
            z-index: 20;
            transition: 0.3s;
            overflow: hidden;
        }

        /* cork / heart stopper - red heart */
        .cork-heart {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background: #ff99b4;
            width: 110px;
            height: 45px;
            border-radius: 60% 60% 30% 30%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.3rem;
            color: white;
            box-shadow: 0 10px 0 #b54b65;
            border: 3px solid #ffe6ed;
            z-index: 30;
        }
        /* red heart icon inside cork */
        .cork-heart i {
            color: #ff2a4a; /* bright red */
        }

        /* floating letters inside bottle (interactive) */
        .letter-stack {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 22px;
            margin: 35px 0 25px;
            perspective: 800px;
        }

        .letter {
            background: #fff6f9;
            width: 130px;
            height: 160px;
            border-radius: 20px 5px 20px 5px;
            box-shadow: 10px 14px 0 #ffb6c1, 0 15px 25px rgba(255, 80, 120, 0.4);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.42, 1.3, 0.8, 1.2);
            border: 3px solid white;
            transform-style: preserve-3d;
            position: relative;
        }

        /* each letter has a little heart seal - red */
        .letter i {
            font-size: 3.2rem;
            color: #ff2e4d; /* strong red */
            filter: drop-shadow(2px 4px 4px #ffbfcb);
            margin-bottom: 10px;
        }

        .letter span {
            font-family: 'Dancing Script', cursive;
            font-size: 1.5rem;
            font-weight: bold;
            color: #ac3555;
            background: #ffe2e9;
            padding: 4px 12px;
            border-radius: 40px;
        }

        /* opened letter effect */
        .letter.opened {
            transform: rotateY(15deg) rotateX(5deg) scale(1.1);
            background: #fff0f5;
            border: 4px solid #ffb0c0;
            box-shadow: 0 25px 30px #ff99aa;
        }

        .letter:hover:not(.no-click) {
            transform: scale(1.1) translateY(-8px);
            box-shadow: 8px 15px 0 #ff8da1, 0 20px 30px #ff99bb;
        }

        /* surprise hidden message box */
        .revealed-message {
            background: #ffeef2;
            border-radius: 50px 15px 50px 15px;
            padding: 1.2rem 1.8rem;
            font-size: 1.5rem;
            color: #9f364b;
            border: 4px dashed #ff90a5;
            margin: 30px 0 20px;
            font-family: 'Dancing Script', cursive;
            font-weight: bold;
            box-shadow: inset 0 0 30px #ffccd9;
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.4s;
            text-align: center;
        }

        .heart-rain {
            position: relative;
            width: 100%;
            height: 60px;
            overflow: hidden;
        }

        .falling-heart {
            position: absolute;
            color: #ff4065; /* bright red */
            font-size: 20px;
            animation: fall 3s linear infinite;
            top: -30px;
        }

        @keyframes fall {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100px) rotate(180deg); opacity: 0; }
        }

        .btn-love {
            background: #ff708d;
            border: none;
            border-radius: 80px 20px 80px 20px;
            padding: 16px 35px;
            font-size: 1.8rem;
            font-weight: 700;
            color: white;
            text-shadow: 2px 2px 2px #a13045;
            box-shadow: 0 12px 0 #9f3b51, 0 12px 30px #ff5e7c;
            transition: 0.08s;
            border: 3px solid #ffe2eb;
        }

        .btn-love i {
            animation: heartbeat 1.3s infinite;
            margin: 0 8px;
            color: white; /* white heart on pink bg, but can be red if we want; keep white for contrast */
        }
        /* but we want red hearts anywhere else? we already set .falling-heart red, ocean bg red */
        .btn-love:active {
            transform: translateY(8px);
            box-shadow: 0 4px 0 #9f3b51, 0 12px 30px #ff5e7c;
        }

        .secret-note {
            font-size: 1.2rem;
            background: white;
            border-radius: 30px;
            padding: 8px 25px;
            display: inline-block;
            color: #c1445a;
            border: 2px solid #ffb0c0;
            margin: 10px;
        }

        /* responsive */
        @media (max-width: 650px) {
            .letter { width: 100px; height: 130px; }
            .letter i { font-size: 2.5rem; }
        }

        /* remove last 2 images - they were in finalSurprise, we delete those <img> */
        /* also ensure any black remains none */
    </style>
</head>
<body>
    <!-- ocean background hearts - all red/pink shades, no black -->
    <div class="ocean-bg">
        <i class="fas fa-heart" style="top:10%; left:5%; color:#ff809d;"></i>
        <i class="fas fa-heart" style="top:30%; left:85%; font-size:80px; color:#ff5277;"></i>
        <i class="fas fa-heart" style="top:70%; left:20%; font-size:60px; color:#ff6f8c;"></i>
        <i class="fas fa-heart" style="top:50%; left:45%; color:#ff3e65;"></i>
        <i class="fas fa-heart" style="top:80%; left:70%; color:#ff2d55;"></i>
    </div>

    <!-- main surprise bottle -->
    <div class="container d-flex justify-content-center">
        <div class="surprise-bottle text-center">

            <!-- cork heart (bottle stopper) with red heart -->
            <div class="cork-heart">
                <i class="fas fa-heart" style="color: #ff1f47;"></i> 
            </div>

            <!-- headline with surprise twist -->
            <h1 style="font-family: 'Dancing Script', cursive; color:#b83252; font-size:3.2rem; margin-top: 25px;">
                <i class="fas fa-envelope-open-text" style="color:#ff4d6d;"></i> 
                Message in a Bottle 
                <i class="fas fa-envelope-open-text" style="color:#ff4d6d;"></i>
            </h1>

            <!-- SUBHEADING: floating letters to open -->
            <p class="secret-note">💘 tap the letters — each hides a sweet secret 💘</p>

            <!-- interactive letter stack (3 surprise letters) -->
            <div class="letter-stack">
                <!-- letter 1 -->
                <div class="letter" id="letter1" data-message="You're the cutest human ever. 🥰">
                    <i class="fas fa-heart" style="color: #ff264f;"></i>
                    <span>open me</span>
                </div>
                <!-- letter 2 -->
                <div class="letter" id="letter2" data-message="I choose you, today and every day. 💌">
                    <i class="fas fa-heart-circle-plus" style="color: #ff264f;"></i>
                    <span>kiss here</span>
                </div>
                <!-- letter 3 -->
                <div class="letter" id="letter3" data-message="Will you be my Valentine? (say yes!) 💗">
                    <i class="fas fa-heart-pulse" style="color: #ff264f;"></i>
                    <span>💖 love</span>
                </div>
                <!-- letter 4 extra surprise -->
                <div class="letter" id="letter4" data-message="You + me = infinite smiles. 😊💞">
                    <i class="fas fa-heart" style="color: #ff264f;"></i>
                    <span>secret</span>
                </div>
            </div>

            <!-- revealed message area (dynamic) -->
            <div id="revealBox" class="revealed-message">
                💕 tap a letter for a surprise... 💕
            </div>

            <!-- heart rain container (jquery falling hearts) - they are already red -->
            <div id="heartRain" class="heart-rain mt-2 mb-3"></div>

            <!-- special proposal area: yes / no with twist -->
            <div class="row g-3 justify-content-center align-items-center mt-2">
                <div class="col-md-5 col-12">
                    <button id="surpriseYesBtn" class="btn-love w-100">
                        <i class="fas fa-heart"></i> YES! <i class="fas fa-heart"></i>
                    </button>
                </div>
                <div class="col-md-5 col-12">
                    <!-- EVASIVE NO BUTTON (still moves) but cuter -->
                    <div id="noWrapper" style="display: inline-block; width: 100%;">
                        <button id="surpriseNoBtn" class="btn btn-outline-danger w-100" style="background:white; border: 4px solid #ff809a; color:#b34159; font-size:1.8rem; font-weight:bold; border-radius: 80px 20px; padding: 12px;">
                            <i class="fas fa-heart-broken"></i> No
                        </button>
                    </div>
                </div>
            </div>

            <!-- hidden final response (big surprise) - IMAGES REMOVED (last 2 images deleted) -->
            <div id="finalSurprise" style="display: none; margin-top: 30px; background: #fff0f5; border-radius: 80px 20px; padding: 25px; border: 6px dotted #ff99bb;">
                <i class="fas fa-heart" style="font-size:4rem; color:#ff1e4f;"></i>
                <h2 style="font-family: 'Dancing Script', cursive; color:#a51f43;">YAY! You unlocked my heart!</h2>
                <div style="font-size:2rem; letter-spacing:10px;">
                    <i class="fas fa-heart" style="color:#ff305b;"></i> <i class="fas fa-heart" style="color:#ff305b;"></i> <i class="fas fa-heart" style="color:#ff305b;"></i>
                </div>
                <p style="font-size:1.7rem;">💝 Happy Valentine's Day, my love! 💝</p>
                <!-- images completely removed as requested -->
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function(){

            // ----- function to create falling hearts (rain) -----
            function createFallingHeart() {
                const rainContainer = $('#heartRain');
                const heart = $('<i class="fas fa-heart falling-heart"></i>');
                const leftPos = Math.random() * 90; // %
                heart.css({
                    left: leftPos + '%',
                    fontSize: (Math.floor(Math.random() * 25) + 16) + 'px',
                    color: Math.random() > 0.5 ? '#ff3d62' : '#ff1f4a', // red shades
                    animationDuration: (Math.random() * 2 + 2) + 's'
                });
                rainContainer.append(heart);
                setTimeout(() => heart.remove(), 3000);
            }
            let rainInterval = setInterval(createFallingHeart, 250);

            // ----- surprise letters: tap to reveal message -----
            $('.letter').on('click', function(e){
                e.preventDefault();
                // add opened effect
                $(this).addClass('opened');
                setTimeout(() => $(this).removeClass('opened'), 400);
                
                // get message from data attribute
                const msg = $(this).data('message') || '💖 you are loved 💖';
                $('#revealBox').html('💌 ' + msg + ' 💌');
                
                // extra heart burst when opening letter
                for (let i=0; i<7; i++) {
                    setTimeout(createFallingHeart, i*40);
                }
            });

            // ----- EVASIVE NO BUTTON (movable, can't catch) -----
            const $noBtn = $('#surpriseNoBtn');
            const $noWrapper = $('#noWrapper');
            
            function moveNoButtonSurprise() {
                const parent = $noWrapper.parent(); // col
                const pW = parent.width();
                const pH = parent.height();
                const wW = $noWrapper.outerWidth();
                const wH = $noWrapper.outerHeight();
                let maxX = Math.max(10, pW - wW - 15);
                let maxY = Math.max(10, pH - wH - 15);
                let newX = Math.min(maxX, Math.random() * maxX);
                let newY = Math.min(maxY, Math.random() * maxY);
                $noWrapper.css({
                    'position': 'relative',
                    'left': newX + 'px',
                    'top': newY + 'px',
                    'transition': 'left 0.18s ease-out, top 0.18s ease-out'
                });
            }

            // evade on mouse move near
            $(document).on('mousemove.surprise', function(e) {
                if ($noBtn.prop('disabled')) return;
                const btnOff = $noBtn.offset();
                if (!btnOff) return;
                const w = $noBtn.outerWidth();
                const h = $noBtn.outerHeight();
                const centerX = btnOff.left + w/2;
                const centerY = btnOff.top + h/2;
                const dist = Math.hypot(e.clientX - centerX, e.clientY - centerY);
                if (dist < 180) {
                    if (!window.surpriseCount) window.surpriseCount = 0;
                    window.surpriseCount++;
                    if (window.surpriseCount % 3 === 0) {
                        moveNoButtonSurprise();
                    }
                }
            });

            $noBtn.on('mouseenter', function(){
                if ($noBtn.prop('disabled')) return;
                moveNoButtonSurprise();
                $(this).css('border-color', '#ff3b6f');
            }).on('mouseleave', function(){
                if ($noBtn.prop('disabled')) return;
                $(this).css('border-color', '#ff809a');
            });

            // No click just moves, and never works
            $('#surpriseNoBtn').on('click', function(e){
                e.preventDefault();
                e.stopPropagation();
                for (let i=0; i<8; i++) {
                    setTimeout(moveNoButtonSurprise, i*30);
                }
                // also make a funny message appear in reveal box?
                $('#revealBox').html('😜 Nope! you can\'t say No! 😜');
                createFallingHeart();createFallingHeart();
                return false;
            });

            // ----- YES BUTTON (big surprise) -----
            $('#surpriseYesBtn').on('click', function(e){
                e.preventDefault();
                
                // disable No button & stop evading
                $noBtn.prop('disabled', true);
                $(document).off('mousemove.surprise');
                $noWrapper.css({ left: '0px', top: '0px', transition: 'none' });
                $noBtn.html('<i class="fas fa-heart"></i> YES! <i class="fas fa-heart"></i>').css({
                    'background': '#ffe2eb',
                    'color': '#a52343',
                    'border': '4px solid #ff99bb',
                    'pointer-events': 'none'
                });
                
                // show final surprise message with love
                $('#finalSurprise').fadeIn(500);
                $('#revealBox').html('💖 YOU SAID YES! 💖 forever love');
                
                // massive heart rain
                for (let i=0; i<40; i++) {
                    setTimeout(createFallingHeart, i*20);
                }
                
                // extra change: bottle cork heart animation
                $('.cork-heart').css('background', '#ffb8c6');
            });

            // double click title extra hearts
            $('h1').on('dblclick', function(){
                for (let i=0;i<15;i++) createFallingHeart();
                $('#revealBox').html('🌟 you found a super secret! 🌟');
            });

            // Cleanup interval on page leave
            $(window).on('beforeunload', function(){
                clearInterval(rainInterval);
            });
        });
    </script>

    <!-- Bootstrap JS (for looks only) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
